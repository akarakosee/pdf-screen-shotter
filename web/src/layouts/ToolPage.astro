---
// Tool page template (UI_UX_TASARIM §4.1): H1 + one-sentence description,
// a slotted tool component, then the 640px content section (How it works →
// FAQ → AdSlot). The slot lets different tools (ToolShell for raster export,
// MergeShell for merge) share this SEO/FAQ/filmstrip shell without ToolPage
// needing to know which one it's rendering.
import Base from './Base.astro';
import AdSlot from '../components/AdSlot.astro';
import GlobalFaq from '../components/GlobalFaq.astro';

interface Step {
  name: string;
  text: string;
}
interface QA {
  q: string;
  a: string;
}
interface Props {
  lang: 'en' | 'tr';
  badgeLabel?: string;
  title: string;
  description: string;
  keywords?: string;
  h1: string;
  tagline: string;
  howToName: string;
  howItWorks: string;
  steps: Step[];
  faqTitle?: string;
  faq?: QA[];
  maxWidthClass?: string;
}
const p = Astro.props;

import { globalFaqCopy } from '../i18n/globalFaq';

const allFaqs = [...(p.faq || []), ...globalFaqCopy[p.lang].items];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'HowTo',
      name: p.howToName,
      step: p.steps.map((s, i) => ({
        '@type': 'HowToStep',
        position: i + 1,
        name: s.name,
        text: s.text,
      })),
    },
    {
      '@type': 'FAQPage',
      mainEntity: allFaqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: f.a,
        },
      })),
    },
    {
      '@type': 'SoftwareApplication',
      name: `GoSecurePDF - ${p.h1}`,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'All',
      offers: {
        '@type': 'Offer',
        price: '0.00',
        priceCurrency: 'USD',
      },
    },
  ],
};

function chunk<T>(items: T[], size: number): T[][] {
  const out: T[][] = [];
  for (let i = 0; i < items.length; i += size) out.push(items.slice(i, i + size));
  return out;
}
---

<Base title={p.title} description={p.description} keywords={p.keywords} lang={p.lang}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />

  <div class="mx-auto flex max-w-[720px] flex-col px-4 pt-10 pb-0">
    <span
      class="mb-3 inline-flex items-center gap-2 font-mono text-[11px] tracking-[0.06em] text-amber uppercase dark:text-amber-dark"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-amber shadow-[0_0_8px_var(--color-amber)] dark:bg-amber-dark dark:shadow-[0_0_8px_var(--color-amber-dark)]"></span>
      {p.badgeLabel}
    </span>
    <h1 class="font-display text-xl font-semibold tracking-tight">{p.h1}</h1>
    <p class="mt-1 mb-6 text-sm text-ink-muted dark:text-ink-muted-dark">{p.tagline}</p>
  </div>

  <div class={`mx-auto flex flex-col px-4 mb-8 w-full ${p.maxWidthClass || 'max-w-[720px]'}`}>
    <slot />
  </div>

  <!-- Viral Share & Recommendation Bar -->
  <div class="mx-auto flex max-w-[720px] w-full px-4 mt-8 mb-12">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 p-4 w-full rounded-xl border border-border/80 dark:border-border-dark/80 bg-surface/40 dark:bg-surface-dark/40 backdrop-blur-sm">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-amber/10 text-amber dark:bg-amber-dark/10 dark:text-amber-dark">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
        </div>
        <div>
          <p class="text-sm font-semibold text-ink dark:text-ink-dark">
            {p.lang === 'tr' ? 'Bu aracı faydalı buldunuz mu?' : 'Found this tool helpful?'}
          </p>
          <p class="text-xs text-ink-muted dark:text-ink-muted-dark">
            {p.lang === 'tr' ? 'Arkadaşlarınızla ve çalışma grubunuzla paylaşın.' : 'Share it with your colleagues or study group.'}
          </p>
        </div>
      </div>
      <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
        <button
          type="button"
          id="copy-page-btn"
          class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-border dark:border-border-dark bg-surface dark:bg-surface-dark px-3 py-2 text-xs font-medium text-ink dark:text-ink-dark hover:border-amber dark:hover:border-amber-dark hover:text-amber dark:hover:text-amber-dark transition-all cursor-pointer shadow-sm"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
          <span id="copy-btn-text">{p.lang === 'tr' ? 'Linki Kopyala' : 'Copy Link'}</span>
        </button>
        <a
          href={`https://api.whatsapp.com/send?text=${encodeURIComponent((p.title || 'GoSecurePDF') + ' — ' + Astro.url.href)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-[#25D366]/10 text-[#25D366] hover:bg-[#25D366] hover:text-white px-3 py-2 text-xs font-medium transition-all cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"/><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"/></svg>
          WhatsApp
        </a>
      </div>
    </div>
  </div>

  <script is:inline>
    const btn = document.getElementById('copy-page-btn');
    const txt = document.getElementById('copy-btn-text');
    if (btn && txt) {
      btn.addEventListener('click', () => {
        navigator.clipboard.writeText(window.location.href).then(() => {
          const orig = txt.textContent;
          txt.textContent = '✓ Copied!';
          setTimeout(() => { txt.textContent = orig; }, 2000);
        });
      });
    }
  </script>

  <div class="mx-auto flex max-w-[720px] flex-col px-4 pb-0">
    <section class="reveal relative pb-0" data-reveal>
      <h2 class="font-heading text-lg font-semibold">{p.howItWorks}</h2>
      <div class="filmstrip mt-3">
        {
          p.steps.map((s, i) => (
            <div class="filmstrip-frame">
              <div class="filmstrip-sprockets" aria-hidden="true" />
              <div class="font-heading text-lg font-semibold text-accent dark:text-amber-dark">
                {String(i + 1).padStart(2, '0')}
              </div>
              <h3 class="mt-3 text-sm font-semibold">{s.name}</h3>
              <p class="mt-1.5 text-xs text-ink-muted dark:text-ink-muted-dark">{s.text}</p>
            </div>
          ))
        }
      </div>
    </section>
  </div>

  
  


  <div class="mx-auto flex max-w-[720px] flex-col px-4 mt-12 pb-0">
    <h2 class="font-heading text-xl font-semibold mb-4 text-ink dark:text-ink-dark">
      {p.lang === 'tr' ? 'Popüler PDF Araçları' : 'Popular PDF Tools'}
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm font-medium">
      <a href={p.lang === 'tr' ? '/tr/split-pdf' : '/split-pdf'} class="flex items-center gap-2 text-ink-muted hover:text-amber dark:text-ink-muted-dark dark:hover:text-amber-dark transition-colors p-3 border border-border dark:border-border-dark rounded-lg hover:border-amber dark:hover:border-amber-dark">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M9 13h6"></path><path d="M9 17h6"></path><path d="M21 15v.01"></path><path d="M3 15v.01"></path></svg>
        {p.lang === 'tr' ? 'PDF Böl' : 'Split PDF'}
      </a>
      <a href={p.lang === 'tr' ? '/tr/merge-pdf' : '/merge-pdf'} class="flex items-center gap-2 text-ink-muted hover:text-amber dark:text-ink-muted-dark dark:hover:text-amber-dark transition-colors p-3 border border-border dark:border-border-dark rounded-lg hover:border-amber dark:hover:border-amber-dark">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="m9 15 2 2 4-4"></path></svg>
        {p.lang === 'tr' ? 'PDF Birleştir' : 'Merge PDF'}
      </a>
      <a href={p.lang === 'tr' ? '/tr/pdf-to-jpg' : '/pdf-to-jpg'} class="flex items-center gap-2 text-ink-muted hover:text-amber dark:text-ink-muted-dark dark:hover:text-amber-dark transition-colors p-3 border border-border dark:border-border-dark rounded-lg hover:border-amber dark:hover:border-amber-dark">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg>
        {p.lang === 'tr' ? 'PDF to JPG' : 'Convert PDF to JPG'}
      </a>
      <a href={p.lang === 'tr' ? '/tr/compress-pdf' : '/compress-pdf'} class="flex items-center gap-2 text-ink-muted hover:text-amber dark:text-ink-muted-dark dark:hover:text-amber-dark transition-colors p-3 border border-border dark:border-border-dark rounded-lg hover:border-amber dark:hover:border-amber-dark">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"></path><path d="m8 15 4 4 4-4"></path><path d="M12 12v7"></path></svg>
        {p.lang === 'tr' ? 'PDF Küçült' : 'Compress PDF'}
      </a>
      <a href={p.lang === 'tr' ? '/tr/protect-pdf' : '/protect-pdf'} class="flex items-center gap-2 text-ink-muted hover:text-amber dark:text-ink-muted-dark dark:hover:text-amber-dark transition-colors p-3 border border-border dark:border-border-dark rounded-lg hover:border-amber dark:hover:border-amber-dark">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        {p.lang === 'tr' ? 'PDF Şifrele' : 'Protect PDF'}
      </a>
      <a href={p.lang === 'tr' ? '/tr/ocr-pdf' : '/ocr-pdf'} class="flex items-center gap-2 text-ink-muted hover:text-amber dark:text-ink-muted-dark dark:hover:text-amber-dark transition-colors p-3 border border-border dark:border-border-dark rounded-lg hover:border-amber dark:hover:border-amber-dark">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7V5a2 2 0 0 1 2-2h2"></path><path d="M17 3h2a2 2 0 0 1 2 2v2"></path><path d="M21 17v2a2 2 0 0 1-2 2h-2"></path><path d="M7 21H5a2 2 0 0 1-2-2v-2"></path><path d="M10 8h4"></path><path d="M12 8v8"></path></svg>
        {p.lang === 'tr' ? 'PDF OCR' : 'OCR PDF (Text)'}
      </a>
    </div>
  </div>


  <div class="mt-11">

    <GlobalFaq lang={p.lang} toolFaq={p.faq} />
  </div>
</Base>
