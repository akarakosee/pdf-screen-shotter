---
// Content/legal page template (UI_UX_TASARIM §4.3): 640px single column,
// display serif headings, tight typographic rhythm.
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  h1: string;
  lang?: 'en' | 'tr';
}
const { title, description, h1, lang = 'en' } = Astro.props;
---

<Base title={title} description={description} lang={lang}>
  <article
    class="prose-content mx-auto max-w-[640px] px-4 pt-16 pb-[90px] text-sm text-ink-muted dark:text-ink-muted-dark [&_h2]:font-heading [&_h2]:text-lg [&_h2]:font-semibold [&_h2]:text-ink [&_h2]:dark:text-ink-dark [&_h2]:mt-9 [&_h2]:mb-3 [&_p]:mt-4 [&_p]:leading-[1.75] [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-5 [&_li]:mt-1 [&_a]:text-accent [&_a]:dark:text-teal-dark [&_a]:underline-offset-2"
  >
    <h1 class="font-display text-2xl font-semibold tracking-tight text-ink dark:text-ink-dark">{h1}</h1>
    <slot />
  </article>
</Base>
