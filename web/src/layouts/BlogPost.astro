---
import Base from './Base.astro';

const { frontmatter, lang } = Astro.props;
const { title, description } = frontmatter;
---
<Base title={title} description={description} lang={lang}>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
    <header class="mb-10 text-center">
      <h1 class="text-3xl font-extrabold tracking-tight text-ink dark:text-ink-dark sm:text-4xl">
        {title}
      </h1>
      <p class="mt-4 text-lg text-ink-muted dark:text-ink-muted-dark">
        {description}
      </p>
    </header>
    <div class="prose prose-lg dark:prose-invert mx-auto">
      <slot />
    </div>
  </article>
</Base>
