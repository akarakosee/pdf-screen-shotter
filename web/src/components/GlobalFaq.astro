---
import { globalFaqCopy } from '../i18n/globalFaq';

interface Props {
  lang: 'en' | 'tr';
  toolFaq?: {q: string, a: string}[];
}

const { lang, toolFaq = [] } = Astro.props;
const { title, items } = globalFaqCopy[lang];

// Deduplicate questions to guarantee no overlapping or repeated entries across tools
const seenQuestions = new Set<string>();
const allFaq: { q: string; a: string }[] = [];
for (const item of [...toolFaq, ...items]) {
  const norm = item.q.trim().toLowerCase();
  if (!seenQuestions.has(norm)) {
    seenQuestions.add(norm);
    allFaq.push(item);
  }
}
---

<section class="reveal mt-10 mx-auto max-w-[640px] px-4 pb-16" data-reveal>
  <h2 class="font-heading text-lg font-semibold">{title}</h2>
  <div class="mt-4 flex flex-col divide-y divide-ink-muted/10 border-y border-ink-muted/10 dark:divide-ink-muted-dark/10 dark:border-ink-muted-dark/10">
    {
      allFaq.map((item) => (
        <details class="group py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between rounded-sm text-sm font-medium outline-none transition-colors hover:text-amber focus-visible:ring-2 focus-visible:ring-accent dark:hover:text-amber-dark">
            {item.q}
            <span class="ml-4 shrink-0 text-ink-muted transition-transform duration-300 group-open:-rotate-180 dark:text-ink-muted-dark group-hover:text-amber dark:group-hover:text-amber-dark">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="mt-3 text-sm leading-relaxed text-ink-muted dark:text-ink-muted-dark">
            {item.a}
          </div>
        </details>
      ))
    }
  </div>
</section>
