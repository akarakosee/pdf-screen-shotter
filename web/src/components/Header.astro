---
interface Props {
  lang: 'en' | 'tr';
}
const { lang } = Astro.props;
const path = Astro.url.pathname;
const normalizedPath = path.replace(/\/$/, '') || '/';
const enPath = path.replace(/^\/tr(\/|$)/, '/') || '/';
const trPath = enPath === '/' ? '/tr/' : `/tr${enPath}`;
const p = lang === 'tr' ? '/tr' : '';
const t = {
  en: {
    theme: 'Toggle dark mode',
    otherLang: 'Türkçe',
    otherHref: trPath,
    tools: [],
    more: 'Menu',
  },
  tr: {
    theme: 'Koyu modu değiştir',
    otherLang: 'English',
    otherHref: enPath,
    tools: [],
    more: 'Menü',
  },
}[lang];
---

<header class="w-full border-b bg-surface dark:bg-surface-dark">
  <div class="mx-auto flex h-14 max-w-[1100px] items-center justify-between px-4">
    <div class="flex items-center gap-5">
      <a
        href={p === '' ? '/' : '/tr/'}
        class="flex items-center gap-2.5 font-heading text-md font-semibold tracking-tight"
      >
        <svg class="h-[28px] w-auto shrink-0" viewBox="4 1 16 22" aria-hidden="true">
          <defs>
            <linearGradient id="headerGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="var(--color-amber-dark, #e8b65f)" />
              <stop offset="100%" stop-color="var(--color-amber, #b5822f)" />
            </linearGradient>
          </defs>
          <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z" fill="none" stroke="url(#headerGrad)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          <polyline points="14,2 14,8 20,8" fill="none" stroke="url(#headerGrad)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M9.5,14 V12 A2.5,2 0 0 1 14.5,12 V14" fill="none" stroke="url(#headerGrad)" stroke-width="1.5" stroke-linecap="round" />
          <rect x="8.5" y="13.8" width="7" height="5.5" rx="1.2" fill="url(#headerGrad)" />
        </svg>
        GoSecurePDF
      </a>
      <nav class="flex items-center gap-1 font-mono">
        {
          t.tools.map((tool) => (
            <a
              href={tool.href}
              aria-current={normalizedPath === tool.href ? 'page' : undefined}
              class={`flex h-11 items-center rounded-lg px-2 text-xs hover:text-ink dark:hover:text-ink-dark ${
                normalizedPath === tool.href
                  ? 'text-amber dark:text-amber-dark'
                  : 'text-ink-muted dark:text-ink-muted-dark'
              }`}
            >
              {tool.name}
            </a>
          ))
        }
      </nav>
    </div>

    <!-- Desktop: language + theme inline. -->
    <nav class="hidden items-center gap-1 font-mono sm:flex">
      <a
        href={t.otherHref}
        class="flex h-11 min-w-11 items-center justify-center rounded-lg px-3 text-xs text-ink-muted hover:text-ink dark:text-ink-muted-dark dark:hover:text-ink-dark"
        >{t.otherLang}</a
      >
      <button
        type="button"
        data-theme-toggle
        aria-label={t.theme}
        class="flex h-11 w-11 items-center justify-center rounded-lg text-ink-muted hover:text-ink dark:text-ink-muted-dark dark:hover:text-ink-dark"
      >
        <svg
          class="hidden h-4 w-4 dark:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><circle cx="12" cy="12" r="4"></circle><path
            d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
          ></path></svg
        >
        <svg
          class="h-4 w-4 dark:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg
        >
      </button>
    </nav>

    <!-- Mobile: language + theme collapse into one overflow menu (binding rule). -->
    <details class="relative sm:hidden">
      <summary
        class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-lg text-ink-muted [&::-webkit-details-marker]:hidden"
        aria-label={t.more}
      >
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
          ><circle cx="12" cy="5" r="1"></circle><circle cx="12" cy="12" r="1"></circle><circle
            cx="12"
            cy="19"
            r="1"></circle></svg
        >
      </summary>
      <div
        class="absolute right-0 z-50 mt-1 flex w-44 flex-col rounded-lg border bg-surface p-1 shadow-2 dark:bg-surface-dark"
      >
        <a
          href={t.otherHref}
          class="flex min-h-11 items-center rounded-lg px-3 text-xs hover:bg-bg dark:hover:bg-bg-dark"
          >{t.otherLang}</a
        >
        <button
          type="button"
          data-theme-toggle
          class="flex min-h-11 items-center rounded-lg px-3 text-left text-xs hover:bg-bg dark:hover:bg-bg-dark"
        >
          {t.theme}
        </button>
      </div>
    </details>
  </div>
</header>

<script>
  for (const el of document.querySelectorAll('[data-theme-toggle]')) {
    el.addEventListener('click', () => {
      const dark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    });
  }
</script>
