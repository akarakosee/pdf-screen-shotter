---
import ToolPage from '../layouts/ToolPage.astro';
import { viewerPrefsCopy } from '../i18n/toolCopy';
import { ViewerPrefsShell } from '../components/ViewerPrefsShell';

const copy = viewerPrefsCopy.en;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="en"
>
  <ViewerPrefsShell client:load />
</ToolPage>
