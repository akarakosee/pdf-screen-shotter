  { n: '02', h: 'Choose your action', p: 'Merge, split, protect, unlock, or convert your document using our lightning-fast local tools.' },
  { n: '03', h: 'Download instantly', p: 'Your processed file is saved instantly to your device with zero limits, completely free.' },
];
---

<Base
  title="PDF tools that never see your files"
  description="Free PDF tools that run entirely in your browser. No uploads, no limits, no signup — your files never leave your device."
>
  <section class="mx-auto max-w-[720px] px-4 pt-10 pb-6 text-center">
    <h1 class="font-display text-2xl font-semibold tracking-tight sm:text-[40px]">
      PDF tools that <em class="hero-develop not-italic">never see</em> your files.
    </h1>
    <p class="mx-auto mt-4 max-w-[480px] text-md text-ink-muted dark:text-ink-muted-dark">
      Every conversion happens like this — entirely on your device, nothing ever leaves it.
    </p>
  </section>

  <section class="mx-auto max-w-[1440px] px-4 pb-8">
    <div class="flex justify-center pb-6">
      <span
        class="inline-flex items-center gap-2 rounded-full border bg-surface px-3.5 py-1.5 font-mono text-[11px] tracking-[0.06em] whitespace-nowrap text-amber uppercase shadow-1 dark:border-white/[0.14] dark:bg-surface-dark dark:text-amber-dark"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-amber shadow-[0_0_8px_var(--color-amber)] dark:bg-amber-dark dark:shadow-[0_0_8px_var(--color-amber-dark)]"></span>
        No uploads · no signup · free
      </span>
    </div>
    <div class="flex flex-wrap items-center justify-center gap-2 pb-6" id="category-filters">
      <button class="filter-btn active rounded-full px-4 py-2 font-mono text-[13px] tracking-wide transition-colors duration-200 bg-amber text-bg dark:bg-amber-dark dark:text-bg-dark font-bold shadow-sm" data-category="All">All</button>
      <button class="filter-btn rounded-full border border-black/10 dark:border-white/10 bg-surface dark:bg-surface-dark px-4 py-2 font-mono text-[13px] tracking-wide text-ink-muted dark:text-ink-muted-dark hover:border-amber dark:hover:border-amber-dark transition-colors duration-200" data-category="Organize PDF">Organize PDF</button>
      <button class="filter-btn rounded-full border border-black/10 dark:border-white/10 bg-surface dark:bg-surface-dark px-4 py-2 font-mono text-[13px] tracking-wide text-ink-muted dark:text-ink-muted-dark hover:border-amber dark:hover:border-amber-dark transition-colors duration-200" data-category="Optimize PDF">Optimize PDF</button>
      <button class="filter-btn rounded-full border border-black/10 dark:border-white/10 bg-surface dark:bg-surface-dark px-4 py-2 font-mono text-[13px] tracking-wide text-ink-muted dark:text-ink-muted-dark hover:border-amber dark:hover:border-amber-dark transition-colors duration-200" data-category="Convert PDF">Convert PDF</button>
      <button class="filter-btn rounded-full border border-black/10 dark:border-white/10 bg-surface dark:bg-surface-dark px-4 py-2 font-mono text-[13px] tracking-wide text-ink-muted dark:text-ink-muted-dark hover:border-amber dark:hover:border-amber-dark transition-colors duration-200" data-category="Edit PDF">Edit PDF</button>
      <button class="filter-btn rounded-full border border-black/10 dark:border-white/10 bg-surface dark:bg-surface-dark px-4 py-2 font-mono text-[13px] tracking-wide text-ink-muted dark:text-ink-muted-dark hover:border-amber dark:hover:border-amber-dark transition-colors duration-200" data-category="PDF Security">PDF Security</button>
      <button class="filter-btn rounded-full border border-black/10 dark:border-white/10 bg-surface dark:bg-surface-dark px-4 py-2 font-mono text-[13px] tracking-wide text-ink-muted dark:text-ink-muted-dark hover:border-amber dark:hover:border-amber-dark transition-colors duration-200" data-category="PDF Intelligence">PDF Intelligence</button>
    </div>
    <DevelopingTray trayLabel="DEVELOPING TRAY" />
  </section>

  
  <section class="mx-auto max-w-[1440px] px-4 pb-[16px]">
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        tools.map((tool) => (
          <li data-category={tool.category} class="tool-item transition-all duration-300 transform scale-100 opacity-100">
            <a
              href={tool.href}
              class="group flex h-[114px] flex-col justify-between rounded-2xl border bg-surface p-5 shadow-1 transition-all duration-[200ms] hover:-translate-y-0.5 hover:border-amber dark:bg-gradient-to-br dark:from-surface-dark dark:to-bg-dark dark:hover:border-amber-dim-dark"
            >
              <span class="font-mono text-[11px] text-ink-muted dark:text-ink-faint-dark">{tool.idx}</span>
              <span class="flex items-center gap-2 font-heading text-md font-semibold">
                <tool.Icon aria-hidden="true" className="h-4.5 w-4.5 shrink-0 text-accent dark:text-teal-dark" strokeWidth={1.75} />
                {tool.name}
              </span>
              <span class="truncate text-xs text-ink-muted dark:text-ink-muted-dark">{tool.line}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-[720px] px-4 pb-10">
    <h2 class="mb-3 font-heading text-lg font-semibold">How it works</h2>
    <div class="filmstrip">
      {
        steps.map((step) => (
          <div class="filmstrip-frame">
            <div class="filmstrip-sprockets" aria-hidden="true" />
            <div class="font-heading text-lg font-semibold text-accent dark:text-amber-dark">{step.n}</div>
            <h3 class="mt-3 text-sm font-semibold">{step.h}</h3>
            <p class="mt-1.5 text-xs text-ink-muted dark:text-ink-muted-dark">{step.p}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-[640px] px-4 pb-8">
    <div
      class="rounded-2xl border p-6 sm:p-8 dark:bg-gradient-to-br dark:from-teal-dim-dark/10 dark:via-amber-dim-dark/10 dark:to-russet-dim-dark/10"
    >
      <p class="text-sm">
        Every tool on this site does its work inside your browser, using WebAssembly. When you
        convert a PDF, the file is read locally by your own device and the result is saved back
        to it — no copy is ever transmitted to us or to anyone else. There is no server that
        could store, scan, or lose your documents, because no server is involved in processing
        them.
      </p>
      <pre
        class="mt-4 overflow-x-auto rounded-lg border bg-surface p-3 font-mono text-xs text-ink-muted dark:bg-bg-dark dark:text-ink-muted-dark">network requests carrying file data during conversion: 0</pre>
    </div>
  </section>

  <GlobalFaq lang="en" />
</Base>


<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filters = document.querySelectorAll('.filter-btn');
    const tools = document.querySelectorAll('.tool-item');
    
    // Assign unique view-transition-names for smooth grid reflows
    tools.forEach((tool: any, index) => {
      tool.style.viewTransitionName = `tool-item-${index}`;
    });
    
    filters.forEach(btn => {
      btn.addEventListener('click', () => {
        const category = btn.getAttribute('data-category');
        
        const updateDOM = () => {
          // Update active class
          filters.forEach(f => {
            f.classList.remove('bg-amber', 'text-bg', 'dark:bg-amber-dark', 'dark:text-bg-dark', 'font-bold', 'shadow-sm', 'active');
            f.classList.add('border', 'border-black/10', 'dark:border-white/10', 'bg-surface', 'dark:bg-surface-dark', 'text-ink-muted', 'dark:text-ink-muted-dark');
          });
          
          btn.classList.add('bg-amber', 'text-bg', 'dark:bg-amber-dark', 'dark:text-bg-dark', 'font-bold', 'shadow-sm', 'active');
          btn.classList.remove('border', 'border-black/10', 'dark:border-white/10', 'bg-surface', 'dark:bg-surface-dark', 'text-ink-muted', 'dark:text-ink-muted-dark');
          
          tools.forEach((tool: any) => {
            if (category === 'All' || tool.getAttribute('data-category') === category) {
              tool.style.display = 'block';
            } else {
              tool.style.display = 'none';
            }
          });
        };

        if (document.startViewTransition) {
          document.startViewTransition(() => {
            updateDOM();
          });
        } else {
          updateDOM();
        }
      });
    });
  });
</script>
