---
import Base from '../layouts/Base.astro';
import { FileImage, Image } from 'lucide-react';

const tools = [
  {
    href: '/pdf-to-png',
    name: 'PDF to PNG',
    line: 'Lossless images for text and diagrams',
    Icon: FileImage,
  },
  {
    href: '/pdf-to-jpg',
    name: 'PDF to JPG',
    line: 'Smaller files for photos and scans',
    Icon: Image,
  },
];
---

<Base
  title="PDF tools that never see your files"
  description="Free PDF tools that run entirely in your browser. No uploads, no limits, no signup — your files never leave your device."
>
  <section class="mx-auto max-w-[720px] px-4 pt-16 pb-12">
    <h1 class="font-display text-2xl font-[650] tracking-tight">
      PDF tools that never see your files.
    </h1>
    <p class="mt-3 text-md text-ink-muted dark:text-ink-muted-dark">
      Works in your browser · no uploads · no signup · free
    </p>
  </section>

  <section class="mx-auto max-w-[720px] px-4 pb-12">
    <ul class="grid gap-3 sm:grid-cols-2">
      {
        tools.map((tool) => (
          <li>
            <a
              href={tool.href}
              class="flex min-h-11 items-center gap-3 rounded-m border bg-surface p-4 shadow-1 transition-colors duration-[120ms] hover:border-accent dark:bg-surface-dark"
            >
              <tool.Icon aria-hidden="true" className="h-5 w-5 shrink-0 text-accent" strokeWidth={1.75} />
              <span>
                <span class="block text-sm font-medium">{tool.name}</span>
                <span class="block text-xs text-ink-muted dark:text-ink-muted-dark">{tool.line}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-[640px] px-4 pb-16">
    <p class="text-sm">
      Every tool on this site does its work inside your browser, using WebAssembly. When you
      convert a PDF, the file is read locally by your own device and the result is saved back
      to it — no copy is ever transmitted to us or to anyone else. There is no server that
      could store, scan, or lose your documents, because no server is involved in processing
      them. The code is open source, so this claim can be checked rather than trusted.
    </p>
    <pre
      class="mt-4 overflow-x-auto rounded-s border bg-surface p-3 font-mono text-xs text-ink-muted dark:bg-surface-dark dark:text-ink-muted-dark">network requests carrying file data during conversion: 0</pre>
  </section>
</Base>
