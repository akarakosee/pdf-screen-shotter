---
import ToolPage from '../layouts/ToolPage.astro';
import { splitBlankCopy } from '../i18n/toolCopy';
import { SplitBlankShell } from '../components/SplitBlankShell';

const copy = splitBlankCopy.en;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="en"
>
  <SplitBlankShell client:load />
</ToolPage>
