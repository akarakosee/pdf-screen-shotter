---
import Prose from '../layouts/Prose.astro';
---

<Prose
  title="Contact"
  description="How to reach the maintainer of this site — questions, bug reports, and feature requests."
  h1="Contact"
>
  <p>
    Found a bug, have a feature request, or a PDF that doesn't convert correctly?
    You can reach out via email.
  </p>
  <div class="prose-accent">
    <p class="mb-2">Everything else:</p>
    <a href="mailto:support@gosecurepdf.com">support@gosecurepdf.com</a>
  </div>
  <p>
    Please do not attach sensitive documents to emails. If a specific PDF fails to
    convert, describe the problem instead; because files never reach us, we cannot see
    what went wrong on your device without your description.
  </p>
</Prose>
