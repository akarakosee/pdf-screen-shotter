---
import ToolPage from '../layouts/ToolPage.astro';
import { splitBookmarksCopy } from '../i18n/toolCopy';
import { SplitBookmarksShell } from '../components/SplitBookmarksShell';

const copy = splitBookmarksCopy.en;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="en"
>
  <SplitBookmarksShell client:load />
</ToolPage>
