---
import ToolPage from '../layouts/ToolPage.astro';
import { pdfToWebpCopy } from '../i18n/toolCopy';
import { PdfToWebpShell } from '../components/PdfToWebpShell';

const copy = pdfToWebpCopy.en;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="en"
>
  <PdfToWebpShell client:load />
</ToolPage>
