---
import ToolPage from '../layouts/ToolPage.astro';
import { extractAttachmentsCopy } from '../i18n/toolCopy';
import { ExtractAttachmentsShell } from '../components/ExtractAttachmentsShell';

const copy = extractAttachmentsCopy.en;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="en"
>
  <ExtractAttachmentsShell client:load />
</ToolPage>
