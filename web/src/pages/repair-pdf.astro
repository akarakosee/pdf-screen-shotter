---
import ToolPage from '../layouts/ToolPage.astro';
import { RepairShell } from '../components/RepairShell';
import { repairCopy } from '../i18n/toolCopy';
const t = repairCopy.en;
---

<ToolPage
  lang="en"
  title={t.title}
  description={t.description}
  h1={t.h1}
  tagline={t.tagline}
  howToName={t.howToName}
  howItWorks={t.howItWorks}
  steps={t.steps}
  faq={t.faq}
>
  <RepairShell client:only="react" desktopAppUrl="https://localpdf.com" />
</ToolPage>
