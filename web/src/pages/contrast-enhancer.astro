---
import ToolPage from '../layouts/ToolPage.astro';
import { contrastEnhancerCopy } from '../i18n/toolCopy';
import { ContrastEnhancerShell } from '../components/ContrastEnhancerShell';

const copy = contrastEnhancerCopy.en;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="en"
>
  <ContrastEnhancerShell client:load />
</ToolPage>
