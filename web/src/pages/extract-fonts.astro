---
import ToolPage from '../layouts/ToolPage.astro';
import { extractFontsCopy } from '../i18n/toolCopy';
import { ExtractFontsShell } from '../components/ExtractFontsShell';

const copy = extractFontsCopy.en;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="en"
>
  <ExtractFontsShell client:load />
</ToolPage>
