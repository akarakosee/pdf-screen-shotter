---
import ToolPage from '../layouts/ToolPage.astro';
import { audioReaderCopy } from '../i18n/toolCopy';
import { AudioReaderShell } from '../components/AudioReaderShell';

const copy = audioReaderCopy.en;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="en"
>
  <AudioReaderShell client:load />
</ToolPage>
