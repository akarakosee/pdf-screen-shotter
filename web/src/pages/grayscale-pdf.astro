---
import ToolPage from '../layouts/ToolPage.astro';
import { GrayscaleShell } from '../components/GrayscaleShell';
import { grayscaleCopy } from '../i18n/toolCopy';
import { en } from '../i18n/en';

const t = grayscaleCopy.en;
---

<ToolPage
  lang="en"
  title={t.title}
  description={t.description}
  h1={t.h1}
  tagline={t.tagline}
  howToName={t.howToName}
  howItWorks={t.howItWorks}
  steps={t.steps}
  faq={t.faq}
>
  <GrayscaleShell client:load t={en} />
</ToolPage>
