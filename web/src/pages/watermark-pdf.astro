---
import ToolPage from '../layouts/ToolPage.astro';
import { watermarkCopy } from '../i18n/toolCopy';
import { WatermarkShell } from '../components/WatermarkShell';

const copy = watermarkCopy.en;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  crossLink={copy.crossLink}
  lang="en"
>
  <WatermarkShell client:load />
</ToolPage>
