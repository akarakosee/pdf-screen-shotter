---
import ToolPage from '../layouts/ToolPage.astro';
import { extractColorsCopy } from '../i18n/toolCopy';
import { ExtractColorsShell } from '../components/ExtractColorsShell';

const copy = extractColorsCopy.en;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="en"
>
  <ExtractColorsShell client:load />
</ToolPage>
