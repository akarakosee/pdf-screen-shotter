---
import ToolPage from '../layouts/ToolPage.astro';
import { scanToPdfCopy } from '../i18n/toolCopy';
import { ScanToPdfShell } from '../components/ScanToPdfShell';

const copy = scanToPdfCopy.en;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="en"
>
  <ScanToPdfShell client:load />
</ToolPage>
