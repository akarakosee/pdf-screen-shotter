---
import ToolPage from '../layouts/ToolPage.astro';
import { removeAnnotationsCopy } from '../i18n/toolCopy';
import { RemoveAnnotationsShell } from '../components/RemoveAnnotationsShell';

const copy = removeAnnotationsCopy.en;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="en"
>
  <RemoveAnnotationsShell client:load />
</ToolPage>
