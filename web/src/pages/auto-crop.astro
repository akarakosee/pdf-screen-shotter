---
import ToolPage from '../layouts/ToolPage.astro';
import { autoCropCopy } from '../i18n/toolCopy';
import { AutoCropShell } from '../components/AutoCropShell';

const copy = autoCropCopy.en;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="en"
>
  <AutoCropShell client:load />
</ToolPage>
