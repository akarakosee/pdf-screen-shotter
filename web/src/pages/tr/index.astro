---
import Base from '../../layouts/Base.astro';
import { FileImage, Image } from 'lucide-react';
import DevelopingTray from '../../components/DevelopingTray.astro';

const tools = [
  {
    href: '/tr/pdf-to-png',
    idx: 'FİLM · KAYIPSIZ',
    name: "PDF'ten PNG'ye",
    line: 'Metin ve şemalar için kayıpsız görüntü',
    Icon: FileImage,
  },
  {
    href: '/tr/pdf-to-jpg',
    idx: 'FİLM · SIKIŞTIRILMIŞ',
    name: "PDF'ten JPG'ye",
    line: 'Fotoğraf ve taramalar için küçük dosyalar',
    Icon: Image,
  },
];

const steps = [
  { n: '01', h: 'Dosyayı yükle', p: 'Bir PDF sürükleyin veya seçin — doğrudan hafızaya okunur, hiçbir yere gönderilmez.' },
  { n: '02', h: 'Pozlamayı ayarla', p: 'Çözünürlük ve sayfa aralığını seçin. Çoğu belge için 150 DPI yeterlidir.' },
  { n: '03', h: 'Sayfaları çek', p: 'Sayfalar tek tek işlenir ve doğrudan cihazınıza indirilir.' },
];
---

<Base
  title="Dosyalarınızı hiç görmeyen PDF araçları"
  description="Tamamen tarayıcınızda çalışan ücretsiz PDF araçları. Yükleme yok, limit yok, kayıt yok — dosyalarınız cihazınızdan çıkmaz."
  lang="tr"
>
  <section class="mx-auto max-w-[720px] px-4 pt-16 pb-10 text-center">
    <span
      class="mb-6 inline-flex items-center gap-2 rounded-full border px-3.5 py-1.5 font-mono text-[11px] tracking-[0.06em] text-amber uppercase dark:border-amber-dim-dark/60 dark:text-amber-dark"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-amber shadow-[0_0_8px_var(--color-amber)] dark:bg-amber-dark dark:shadow-[0_0_8px_var(--color-amber-dark)]"></span>
      Yükleme yok · kayıt yok · ücretsiz
    </span>
    <h1 class="font-display text-2xl font-semibold tracking-tight sm:text-[40px]">
      Dosyalarınızı <em class="hero-develop not-italic">hiç görmeyen</em> PDF araçları.
    </h1>
    <p class="mx-auto mt-4 max-w-[480px] text-md text-ink-muted dark:text-ink-muted-dark">
      Her dönüşüm böyle gerçekleşir — tamamen cihazınızda, hiçbir şey cihazınızdan çıkmadan.
    </p>
  </section>

  <section class="mx-auto max-w-[720px] px-4 pb-14">
    <DevelopingTray trayLabel="GELİŞTİRME TEPSİSİ" />
  </section>

  <section class="mx-auto max-w-[720px] px-4 pb-14">
    <ul class="grid gap-3 sm:grid-cols-2">
      {
        tools.map((tool) => (
          <li>
            <a
              href={tool.href}
              class="group flex min-h-11 flex-col gap-2 rounded-m border bg-surface p-5 shadow-1 transition-all duration-[200ms] hover:-translate-y-0.5 hover:border-amber dark:bg-gradient-to-br dark:from-surface-dark dark:to-bg-dark dark:hover:border-amber-dim-dark"
            >
              <span class="font-mono text-[11px] text-ink-muted dark:text-ink-faint-dark">{tool.idx}</span>
              <span class="flex items-center gap-2 font-heading text-md font-semibold">
                <tool.Icon aria-hidden="true" className="h-4.5 w-4.5 shrink-0 text-accent dark:text-teal-dark" strokeWidth={1.75} />
                {tool.name}
              </span>
              <span class="text-xs text-ink-muted dark:text-ink-muted-dark">{tool.line}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-[720px] px-4 pb-14">
    <h2 class="mb-5 font-heading text-lg font-semibold">Nasıl çalışır</h2>
    <div class="filmstrip">
      {
        steps.map((step, i) => (
          <div class={`filmstrip-frame ${i === 1 ? 'filmstrip-frame--mid' : ''}`}>
            <div class="filmstrip-sprockets" aria-hidden="true" />
            <div class="font-heading text-lg font-semibold text-accent dark:text-amber-dark">{step.n}</div>
            <h3 class="mt-3 text-sm font-semibold">{step.h}</h3>
            <p class="mt-1.5 text-xs text-ink-muted dark:text-ink-muted-dark">{step.p}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-[640px] px-4 pb-16">
    <div
      class="rounded-m border p-6 sm:p-8 dark:bg-gradient-to-br dark:from-teal-dim-dark/10 dark:via-amber-dim-dark/10 dark:to-russet-dim-dark/10"
    >
      <p class="text-sm">
        Bu sitedeki her araç, işini WebAssembly kullanarak tarayıcınızın içinde yapar. Bir
        PDF'i dönüştürdüğünüzde dosya kendi cihazınızda okunur ve sonuç yine cihazınıza
        kaydedilir — hiçbir kopyası bize ya da başkasına iletilmez. Belgelerinizi
        saklayabilecek, tarayabilecek veya kaybedebilecek bir sunucu yoktur; çünkü işleme
        sürecinde hiçbir sunucu yer almaz. Kod açık kaynaktır: bu iddiaya güvenmek yerine
        doğrulayabilirsiniz.
      </p>
      <pre
        class="mt-4 overflow-x-auto rounded-s border bg-surface p-3 font-mono text-xs text-ink-muted dark:bg-bg-dark dark:text-ink-muted-dark">dönüşüm sırasında dosya verisi taşıyan ağ isteği: 0</pre>
    </div>
  </section>
</Base>
