---
import Base from '../../layouts/Base.astro';
import { Scissors, FileImage, Image, Images, Layers, Grid3X3, RotateCw, Lock, Unlock, FileText, Eraser, Stamp, Hash, Trash2, FileUp, PenTool, Minimize2 } from 'lucide-react';
import DevelopingTray from '../../components/DevelopingTray.astro';
import GlobalFaq from '../../components/GlobalFaq.astro';

const tools = [
  {
    href: '/tr/pdf-to-png',
    idx: 'FİLM · KAYIPSIZ',
    name: "PDF'ten PNG'ye",
    line: 'Metin ve şemalar için kayıpsız görüntü',
    Icon: FileImage,
  },
  {
    href: '/tr/pdf-to-jpg',
    idx: 'FİLM · SIKIŞTIRILMIŞ',
    name: "PDF'ten JPG'ye",
    line: 'Fotoğraf ve taramalar için küçük dosyalar',
    Icon: Image,
  },
  {
    href: '/tr/png-to-pdf',
    idx: 'DÖNÜŞTÜRÜCÜ · GÖRSELLER',
    name: "PNG'den PDF'e",
    line: 'PNG resimlerini PDF belgesine dönüştürün',
    Icon: FileUp,
  },
  {
    href: '/tr/img-to-pdf',
    idx: 'DÖNÜŞTÜRÜCÜ · GÖRSELLER',
    name: "JPG'den PDF'e",
    line: 'JPG fotoğraflarını PDF belgesine dönüştürün',
    Icon: FileUp,
  },
  {
    href: '/tr/merge-pdf',
    idx: 'BİRLEŞTİR',
    name: 'PDF Birleştir',
    line: 'PDF belgelerini tek dosyada birleştir',
    Icon: Layers,
  },
  {
    href: '/tr/split-pdf',
    idx: 'BÖL · AYIKLA',
    name: 'PDF Böl',
    line: 'Sayfaları ayıkla veya parçalara böl',
    Icon: Scissors,
  },
  {
    href: '/tr/organize-pdf',
    idx: 'DÜZENLE · SIRALA',
    name: 'PDF Düzenle',
    line: 'Sayfaların sırasını ve yönünü düzenle',
    Icon: Grid3X3,
  },
  {
    href: '/tr/protect-pdf',
    idx: 'GÜVENLİK · ŞİFRELE',
    name: 'PDF Şifrele',
    line: 'Belgenizi şifre ile koruyun',
    Icon: Lock,
  },
  {
    href: '/tr/unlock-pdf',
    idx: 'GÜVENLİK · ŞİFRE KALDIR',
    name: 'PDF Şifre Kaldır',
    line: 'PDF dosyasından şifre korumasını kaldır',
    Icon: Unlock,
  },
  {
    href: '/tr/extract-text',
    idx: 'ARAÇ · DIŞA AKTAR',
    name: 'Metin Çıkar',
    line: 'PDF içindeki tüm metinleri çıkarın',
    Icon: FileText,
  },
  {
    href: '/tr/extract-images',
    idx: 'ARAÇ · DIŞA AKTAR',
    name: 'Resim Çıkar',
    line: 'Gömülü JPG ve PNG görsellerini indirin',
    Icon: Images,
  },
  {
    href: '/tr/compress-pdf',
    idx: 'ARAÇ · OPTİMİZE ET',
    name: 'PDF Sıkıştır / Küçült',
    line: 'Kalite kaybı olmadan boyutu küçültün',
    Icon: Minimize2,
  },
  {
    href: '/tr/sanitize-pdf',
    idx: 'GÜVENLİK · TEMİZLE',
    name: 'PDF Temizle',
    line: 'Gizli meta verilerini temizleyin',
    Icon: Eraser,
  },
  {
    href: '/tr/watermark-pdf',
    idx: 'GÜVENLİK · FİLİGRAN',
    name: 'Filigran Ekle',
    line: 'PDF belgenize filigran ekleyin',
    Icon: Stamp,
  },
  {
    href: '/tr/flatten-pdf',
    idx: 'DÜZENLE · DÜZLEŞTİR',
    name: 'PDF Düzleştir',
    line: 'Form ve notları sabit katman yapın',
    Icon: Layers,
  },
  {
    href: '/tr/sign-pdf',
    idx: 'DÜZENLE · İMZALA',
    name: 'PDF İmzala',
    line: 'Belgeye imza ekleyin veya çizin',
    Icon: PenTool,
  },
  {
    href: '/tr/add-page-numbers',
    idx: 'ARAÇ · DÜZENLEME',
    name: 'Sayfa Numarası Ekle',
    line: 'Belgenize sayfa numarası ekleyin',
    Icon: Hash,
  },
  {
    href: '/tr/rotate-pdf',
    idx: 'ARAÇ · DÖNDÜR',
    name: 'PDF Döndür',
    line: 'Sayfaları istediğin yöne döndür',
    Icon: RotateCw,
  },
  {
    href: '/tr/remove-pages',
    idx: 'ARAÇ · SAYFA SİL',
    name: 'PDF Sayfa Sil',
    line: 'İstenmeyen sayfaları belgeden sil',
    Icon: Trash2,
  },
];

const steps = [
  { n: '01', h: 'PDF\'inizi ekleyin', p: 'PDF dosyanızı tarayıcıya bırakın. Dosyanız doğrudan belleğe okunur ve hiçbir sunucuya gönderilmez.' },
  { n: '02', h: 'İşleminizi seçin', p: 'Tamamen yerel araçlarımızı kullanarak belgenizi birleştirin, bölün, şifreleyin veya dönüştürün.' },
  { n: '03', h: 'Anında indirin', p: 'İşlenen dosyanız hiçbir sınır olmadan, tamamen ücretsiz olarak cihazınıza anında kaydedilir.' },
];
---

<Base
  title="Dosyalarınızı hiç görmeyen PDF araçları"
  description="Tamamen tarayıcınızda çalışan ücretsiz PDF araçları. Yükleme yok, limit yok, kayıt yok — dosyalarınız cihazınızdan çıkmaz."
  lang="tr"
>
  <section class="mx-auto max-w-[720px] px-4 pt-10 pb-6 text-center">
    <h1 class="font-display text-2xl font-semibold tracking-tight sm:text-[40px]">
      Dosyalarınızı <em class="hero-develop not-italic">hiç görmeyen</em> PDF araçları.
    </h1>
    <p class="mx-auto mt-4 max-w-[480px] text-md text-ink-muted dark:text-ink-muted-dark">
      Her dönüşüm böyle gerçekleşir — tamamen cihazınızda, hiçbir şey cihazınızdan çıkmadan.
    </p>
  </section>

  <section class="mx-auto max-w-[720px] px-4 pb-8">
    <div class="flex justify-center pb-6">
      <span
        class="inline-flex items-center gap-2 rounded-full border bg-surface px-3.5 py-1.5 font-mono text-[11px] tracking-[0.06em] whitespace-nowrap text-amber uppercase shadow-1 dark:border-white/[0.14] dark:bg-surface-dark dark:text-amber-dark"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-amber shadow-[0_0_8px_var(--color-amber)] dark:bg-amber-dark dark:shadow-[0_0_8px_var(--color-amber-dark)]"></span>
        Yükleme yok · kayıt yok · ücretsiz
      </span>
    </div>
    <DevelopingTray trayLabel="GELİŞTİRME TEPSİSİ" />
  </section>

  <section class="mx-auto max-w-[720px] px-4 pb-8">
    <ul class="grid gap-3 sm:grid-cols-2">
      {
        tools.map((tool) => (
          <li>
            <a
              href={tool.href}
              class="group flex h-[114px] flex-col justify-between rounded-2xl border bg-surface p-5 shadow-1 transition-all duration-[200ms] hover:-translate-y-0.5 hover:border-amber dark:bg-gradient-to-br dark:from-surface-dark dark:to-bg-dark dark:hover:border-amber-dim-dark"
            >
              <span class="font-mono text-[11px] text-ink-muted dark:text-ink-faint-dark">{tool.idx}</span>
              <span class="flex items-center gap-2 font-heading text-md font-semibold">
                <tool.Icon aria-hidden="true" className="h-4.5 w-4.5 shrink-0 text-accent dark:text-teal-dark" strokeWidth={1.75} />
                {tool.name}
              </span>
              <span class="truncate text-xs text-ink-muted dark:text-ink-muted-dark">{tool.line}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-[720px] px-4 pb-10">
    <h2 class="mb-3 font-heading text-lg font-semibold">Nasıl çalışır</h2>
    <div class="filmstrip">
      {
        steps.map((step) => (
          <div class="filmstrip-frame">
            <div class="filmstrip-sprockets" aria-hidden="true" />
            <div class="font-heading text-lg font-semibold text-accent dark:text-amber-dark">{step.n}</div>
            <h3 class="mt-3 text-sm font-semibold">{step.h}</h3>
            <p class="mt-1.5 text-xs text-ink-muted dark:text-ink-muted-dark">{step.p}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-[640px] px-4 pb-8">
    <div
      class="rounded-2xl border p-6 sm:p-8 dark:bg-gradient-to-br dark:from-teal-dim-dark/10 dark:via-amber-dim-dark/10 dark:to-russet-dim-dark/10"
    >
      <p class="text-sm">
        Bu sitedeki her araç, işini WebAssembly kullanarak tarayıcınızın içinde yapar. Bir
        PDF'i dönüştürdüğünüzde dosya kendi cihazınızda okunur ve sonuç yine cihazınıza
        kaydedilir — hiçbir kopyası bize ya da başkasına iletilmez. Belgelerinizi
        saklayabilecek, tarayabilecek veya kaybedebilecek bir sunucu yoktur; çünkü işleme
        sürecinde hiçbir sunucu yer almaz. Kod açık kaynaktır: bu iddiaya güvenmek yerine
        doğrulayabilirsiniz.
      </p>
      <pre
        class="mt-4 overflow-x-auto rounded-lg border bg-surface p-3 font-mono text-xs text-ink-muted dark:bg-bg-dark dark:text-ink-muted-dark">dönüşüm sırasında dosya verisi taşıyan ağ isteği: 0</pre>
    </div>
  </section>

  <GlobalFaq lang="tr" />
</Base>
