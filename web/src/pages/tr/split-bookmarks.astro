---
import ToolPage from '../../layouts/ToolPage.astro';
import { splitBookmarksCopy } from '../../i18n/toolCopy';
import { SplitBookmarksShell } from '../../components/SplitBookmarksShell';
import { tr } from '../../i18n/tr';

const copy = splitBookmarksCopy.tr;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="tr"
>
  <SplitBookmarksShell client:load t={tr} />
</ToolPage>
