---
import ToolPage from '../../layouts/ToolPage.astro';
import { extractHiddenTextCopy } from '../../i18n/toolCopy';
import { ExtractHiddenTextShell } from '../../components/ExtractHiddenTextShell';
import { tr } from '../../i18n/tr';

const copy = extractHiddenTextCopy.tr;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="tr"
>
  <ExtractHiddenTextShell client:load t={tr} />
</ToolPage>
