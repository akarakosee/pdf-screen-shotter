---
import ToolPage from '../../layouts/ToolPage.astro';
import { scanToPdfCopy } from '../../i18n/toolCopy';
import { ScanToPdfShell } from '../../components/ScanToPdfShell';
import { tr } from '../../i18n/tr';

const copy = scanToPdfCopy.tr;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="tr"
>
  <ScanToPdfShell client:load t={tr} />
</ToolPage>
