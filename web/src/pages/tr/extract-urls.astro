---
import ToolPage from '../../layouts/ToolPage.astro';
import { extractUrlsCopy } from '../../i18n/toolCopy';
import { ExtractUrlsShell } from '../../components/ExtractUrlsShell';
import { tr } from '../../i18n/tr';

const copy = extractUrlsCopy.tr;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="tr"
>
  <ExtractUrlsShell client:load t={tr} />
</ToolPage>
