---
import ToolPage from '../../layouts/ToolPage.astro';
import { ReverseShell } from '../../components/ReverseShell';
import { reverseCopy } from '../../i18n/toolCopy';
import { tr } from '../../i18n/tr';

const copy = reverseCopy.tr;
---

<ToolPage
  lang="tr"
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  faqTitle={copy.faqTitle}
  faq={copy.faq}
>
  <ReverseShell client:load t={tr} />
</ToolPage>
