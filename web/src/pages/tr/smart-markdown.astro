---
import ToolPage from '../../layouts/ToolPage.astro';
import { smartMarkdownCopy } from '../../i18n/toolCopy';
import { SmartMarkdownShell } from '../../components/SmartMarkdownShell';
import { tr } from '../../i18n/tr';

const copy = smartMarkdownCopy.tr;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="tr"
>
  <SmartMarkdownShell client:load t={tr} />
</ToolPage>
