---
import ToolPage from '../../layouts/ToolPage.astro';
import { extractTablesCopy } from '../../i18n/toolCopy';
import { ExtractTablesShell } from '../../components/ExtractTablesShell';
import { tr } from '../../i18n/tr';

const copy = extractTablesCopy.tr;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="tr"
>
  <ExtractTablesShell client:load t={tr} />
</ToolPage>
