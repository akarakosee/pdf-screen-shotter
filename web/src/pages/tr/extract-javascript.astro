---
import ToolPage from '../../layouts/ToolPage.astro';
import { extractJavascriptCopy } from '../../i18n/toolCopy';
import { ExtractJavascriptShell } from '../../components/ExtractJavascriptShell';
import { tr } from '../../i18n/tr';

const copy = extractJavascriptCopy.tr;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="tr"
>
  <ExtractJavascriptShell client:load t={tr} />
</ToolPage>
