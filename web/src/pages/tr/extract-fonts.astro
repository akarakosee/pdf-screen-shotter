---
import ToolPage from '../../layouts/ToolPage.astro';
import { extractFontsCopy } from '../../i18n/toolCopy';
import { ExtractFontsShell } from '../../components/ExtractFontsShell';
import { tr } from '../../i18n/tr';

const copy = extractFontsCopy.tr;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="tr"
>
  <ExtractFontsShell client:load t={tr} />
</ToolPage>
