---
import ToolPage from '../../layouts/ToolPage.astro';
import { removeImagesCopy } from '../../i18n/toolCopy';
import { RemoveImagesShell } from '../../components/RemoveImagesShell';
import { tr } from '../../i18n/tr';

const copy = removeImagesCopy.tr;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="tr"
>
  <RemoveImagesShell client:load t={tr} />
</ToolPage>
