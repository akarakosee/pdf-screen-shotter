---
import ToolPage from '../../layouts/ToolPage.astro';
import { removeDuplicatesCopy } from '../../i18n/toolCopy';
import { RemoveDuplicatesShell } from '../../components/RemoveDuplicatesShell';
import { tr } from '../../i18n/tr';

const copy = removeDuplicatesCopy.tr;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="tr"
>
  <RemoveDuplicatesShell client:load t={tr} />
</ToolPage>
