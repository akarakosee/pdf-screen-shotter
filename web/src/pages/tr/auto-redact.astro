---
import ToolPage from '../../layouts/ToolPage.astro';
import { autoRedactCopy } from '../../i18n/toolCopy';
import { AutoRedactShell } from '../../components/AutoRedactShell';
import { tr } from '../../i18n/tr';

const copy = autoRedactCopy.tr;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="tr"
>
  <AutoRedactShell client:load t={tr} />
</ToolPage>
