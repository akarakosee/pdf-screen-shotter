---
import ToolPage from '../../layouts/ToolPage.astro';
import { NUpShell } from '../../components/NUpShell';
import { nupCopy } from '../../i18n/toolCopy';
import { tr } from '../../i18n/tr';

const copy = nupCopy.tr;
---

<ToolPage
  lang="tr"
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  faqTitle={copy.faqTitle}
  faq={copy.faq}
>
  <NUpShell client:load t={tr} />
</ToolPage>
