---
import ToolPage from '../../layouts/ToolPage.astro';
import { extractCopy } from '../../i18n/toolCopy';
import { ExtractShell } from '../../components/ExtractShell';
import { tr } from '../../i18n/tr';

const copy = extractCopy.tr;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="tr"
>
  <ExtractShell t={tr} client:load />
</ToolPage>
