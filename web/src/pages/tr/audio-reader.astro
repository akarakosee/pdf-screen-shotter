---
import ToolPage from '../../layouts/ToolPage.astro';
import { audioReaderCopy } from '../../i18n/toolCopy';
import { AudioReaderShell } from '../../components/AudioReaderShell';
import { tr } from '../../i18n/tr';

const copy = audioReaderCopy.tr;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="tr"
>
  <AudioReaderShell client:load t={tr} />
</ToolPage>
