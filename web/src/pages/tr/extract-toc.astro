---
import ToolPage from '../../layouts/ToolPage.astro';
import { extractTocCopy } from '../../i18n/toolCopy';
import { ExtractTocShell } from '../../components/ExtractTocShell';
import { tr } from '../../i18n/tr';

const copy = extractTocCopy.tr;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="tr"
>
  <ExtractTocShell client:load t={tr} />
</ToolPage>
