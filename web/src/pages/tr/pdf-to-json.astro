---
import ToolPage from '../../layouts/ToolPage.astro';
import { pdfToJsonCopy } from '../../i18n/toolCopy';
import { PdfToJsonShell } from '../../components/PdfToJsonShell';
import { tr } from '../../i18n/tr';

const copy = pdfToJsonCopy.tr;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="tr"
>
  <PdfToJsonShell client:load t={tr} />
</ToolPage>
