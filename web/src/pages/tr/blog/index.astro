---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const trPosts = allPosts.filter(p => p.id.startsWith('tr/'));

const sortedPosts = trPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Base title="PDF Rehberi & Makaleler | GoSecurePDF" description="PDF dosyalarınızı ücretsiz ve güvenli bir şekilde nasıl düzenleyebileceğinizi, birleştireceğinizi ve dönüştürebileceğinizi anlatan rehberler." lang="tr">
  <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mb-12">
      <h1 class="text-4xl font-extrabold tracking-tight text-ink dark:text-ink-dark sm:text-5xl">
        Rehber & Makaleler
      </h1>
      <p class="mt-4 text-xl text-ink-muted dark:text-ink-muted-dark">
        PDF dosyalarınızı en verimli ve güvenli şekilde yönetmeyi öğrenin.
      </p>
    </div>

    <div class="grid gap-8 sm:grid-cols-2">
      {sortedPosts.map((post) => (
        <a href={`/tr/blog/${post.id.replace('tr/', '').replace(/\.mdx?$/, '')}`} class="group flex flex-col justify-between rounded-2xl border border-border bg-bg-surface p-6 shadow-sm transition hover:shadow-md dark:border-border-dark dark:bg-bg-surface-dark">
          <div>
            <h2 class="text-xl font-bold text-ink group-hover:text-amber dark:text-ink-dark dark:group-hover:text-amber-dark">
              {post.data.title}
            </h2>
            <p class="mt-3 text-base text-ink-muted dark:text-ink-muted-dark">
              {post.data.description}
            </p>
          </div>
          <div class="mt-6 flex items-center text-sm font-medium text-ink-subtle dark:text-ink-subtle-dark">
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('tr-TR', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
          </div>
        </a>
      ))}
    </div>
  </div>
</Base>
