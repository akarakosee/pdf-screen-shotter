---
import ToolPage from '../../layouts/ToolPage.astro';
import { overlayPdfCopy } from '../../i18n/toolCopy';
import { OverlayPdfShell } from '../../components/OverlayPdfShell';
import { tr } from '../../i18n/tr';

const copy = overlayPdfCopy.tr;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="tr"
>
  <OverlayPdfShell client:load t={tr} />
</ToolPage>
