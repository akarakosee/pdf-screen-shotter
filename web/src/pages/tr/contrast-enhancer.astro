---
import ToolPage from '../../layouts/ToolPage.astro';
import { contrastEnhancerCopy } from '../../i18n/toolCopy';
import { ContrastEnhancerShell } from '../../components/ContrastEnhancerShell';
import { tr } from '../../i18n/tr';

const copy = contrastEnhancerCopy.tr;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="tr"
>
  <ContrastEnhancerShell client:load t={tr} />
</ToolPage>
