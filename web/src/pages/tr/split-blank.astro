---
import ToolPage from '../../layouts/ToolPage.astro';
import { splitBlankCopy } from '../../i18n/toolCopy';
import { SplitBlankShell } from '../../components/SplitBlankShell';
import { tr } from '../../i18n/tr';

const copy = splitBlankCopy.tr;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="tr"
>
  <SplitBlankShell client:load t={tr} />
</ToolPage>
