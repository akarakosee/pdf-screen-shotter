---
import ToolPage from '../../layouts/ToolPage.astro';
import { numberCopy } from '../../i18n/toolCopy';
import { NumberShell } from '../../components/NumberShell';
import { tr } from '../../i18n/tr';

const copy = numberCopy.tr;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  crossLink={copy.crossLink}
  lang="tr"
>
  <NumberShell t={tr} client:load />
</ToolPage>
