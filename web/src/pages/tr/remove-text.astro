---
import ToolPage from '../../layouts/ToolPage.astro';
import { removeTextCopy } from '../../i18n/toolCopy';
import { RemoveTextShell } from '../../components/RemoveTextShell';
import { tr } from '../../i18n/tr';

const copy = removeTextCopy.tr;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="tr"
>
  <RemoveTextShell client:load t={tr} />
</ToolPage>
