---
import ToolPage from '../../layouts/ToolPage.astro';
import { extractAttachmentsCopy } from '../../i18n/toolCopy';
import { ExtractAttachmentsShell } from '../../components/ExtractAttachmentsShell';
import { tr } from '../../i18n/tr';

const copy = extractAttachmentsCopy.tr;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="tr"
>
  <ExtractAttachmentsShell client:load t={tr} />
</ToolPage>
