---
import ToolPage from '../layouts/ToolPage.astro';
import { ResizeShell } from '../components/ResizeShell';
import { resizeCopy } from '../i18n/toolCopy';
import { en } from '../i18n/en';

const t = resizeCopy.en;
---

<ToolPage
  lang="en"
  title={t.title}
  description={t.description}
  h1={t.h1}
  tagline={t.tagline}
  howToName={t.howToName}
  howItWorks={t.howItWorks}
  steps={t.steps}
  faq={t.faq}
>
  <ResizeShell client:load t={en} />
</ToolPage>
