---
import ToolPage from '../layouts/ToolPage.astro';
import { smartMarkdownCopy } from '../i18n/toolCopy';
import { SmartMarkdownShell } from '../components/SmartMarkdownShell';

const copy = smartMarkdownCopy.en;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="en"
>
  <SmartMarkdownShell client:load />
</ToolPage>
