---
import ToolPage from '../layouts/ToolPage.astro';
import { wipeBookmarksCopy } from '../i18n/toolCopy';
import { WipeBookmarksShell } from '../components/WipeBookmarksShell';

const copy = wipeBookmarksCopy.en;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="en"
>
  <WipeBookmarksShell client:load />
</ToolPage>
