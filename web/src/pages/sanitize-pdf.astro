---
import ToolPage from '../layouts/ToolPage.astro';
import { sanitizeCopy } from '../i18n/toolCopy';
import { SanitizeShell } from '../components/SanitizeShell';

const copy = sanitizeCopy.en;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="en"
>
  <SanitizeShell client:load />
</ToolPage>
