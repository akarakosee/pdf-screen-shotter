---
import ToolPage from '../layouts/ToolPage.astro';
import { changeBgCopy } from '../i18n/toolCopy';
import { ChangeBackgroundShell } from '../components/ChangeBackgroundShell';

const copy = changeBgCopy.en;
---

<ToolPage
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  lang="en"
>
  <ChangeBackgroundShell client:load />
</ToolPage>
