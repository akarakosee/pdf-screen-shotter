---
import ToolPage from '../layouts/ToolPage.astro';
import { BatesShell } from '../components/BatesShell';
import { batesCopy } from '../i18n/toolCopy';

const copy = batesCopy.en;
---

<ToolPage
  lang="en"
  title={copy.title}
  description={copy.description}
  h1={copy.h1}
  tagline={copy.tagline}
  howToName={copy.howToName}
  howItWorks={copy.howItWorks}
  steps={copy.steps}
  faqTitle={copy.faqTitle}
  faq={copy.faq}
>
  <BatesShell client:load />
</ToolPage>
